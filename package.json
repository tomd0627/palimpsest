{
  "name": "palimpsest",
  "version": "1.0.0",
  "description": "A generative visual piece — layers of text and form accumulate, fade, and overwrite each other in real time.",
  "private": true,
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "*.html": ["prettier --write"],
    "*.css": ["stylelint --fix", "prettier --write"],
    "*.js": ["eslint --fix", "prettier --write"]
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "stylelint": "^16.8.0",
    "stylelint-config-standard": "^36.0.1"
  }
}
